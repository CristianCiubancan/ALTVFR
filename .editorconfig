# EditorConfig helps maintain consistent coding styles across platforms
# http://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Windows scripts
[*.{cmd,bat}]
end_of_line = crlf

# Linux/macOS scripts
[*.sh]
end_of_line = lf

# Use 4 spaces for Python files
[*.py]
indent_size = 4