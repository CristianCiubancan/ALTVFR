{
  "name": "altv-react-framework",
  "version": "0.1.0",
  "description": "A modular, hot-reloadable React plugin framework for Alt:V",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development run-s ensure-dirs && run-p dev:*",
    "dev:server": "node scripts/watch-server.js",
    "dev:client": "vite build --watch --config vite.client.config.ts",
    "dev:ui": "astro dev",
    "build": "cross-env NODE_ENV=production run-s clean ensure-dirs build:*",
    "ensure-dirs": "node scripts/ensure-dirs.js",
    "build:server": "rollup -c rollup.server.config.js",
    "build:client": "vite build --config vite.client.config.ts",
    "build:ui": "astro build",
    "build:resources": "node scripts/build-resources.js",
    "start": "node scripts/start-server.js",
    "clean": "rimraf \"resources\" \"dist\"",
    "lint": "eslint --ext .ts,.tsx,.js src plugins scripts",
    "lint:fix": "eslint --ext .ts,.tsx,.js src plugins scripts --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\" \"plugins/**/*.{ts,tsx,js,jsx,json,css}\"",
    "typecheck": "tsc --noEmit",
    "create-plugin": "node scripts/create-plugin.js",
    "build-plugin": "node scripts/build-plugin.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "node scripts/ensure-dirs.js && node scripts/setup-husky.js",
    "validate": "run-s lint typecheck test",
    "binaries": "altv-pkg"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "altv",
    "gta",
    "react",
    "plugins",
    "framework",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@altv/types-client": "^16.2.6",
    "@altv/types-natives": "^16.2.1",
    "@altv/types-server": "^16.2.4",
    "@altv/types-shared": "^16.2.3",
    "@altv/types-webview": "^16.2.1",
    "@altv/types-worker": "^16.2.0",
    "@astrojs/react": "^2.1.0",
    "@astrojs/tailwind": "^3.1.0",
    "astro": "^2.1.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.2.7"
  },
  "devDependencies": {
    "@types/node": "^18.15.5",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@typescript-eslint/eslint-plugin": "^5.56.0",
    "@typescript-eslint/parser": "^5.56.0",
    "@vitejs/plugin-react": "^3.1.0",
    "altv-pkg": "^2.7.5",
    "autoprefixer": "^10.4.14",
    "cross-env": "^7.0.3",
    "esbuild": "^0.17.13",
    "eslint": "^8.36.0",
    "eslint-plugin-astro": "^0.26.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.21",
    "prettier": "^2.8.7",
    "rimraf": "^4.4.0",
    "rollup": "^3.20.2",
    "rollup-plugin-esbuild": "^5.0.0",
    "typescript": "^5.0.2",
    "vite": "^4.2.1",
    "vitest": "^0.29.7"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}